{
	"packages": [{
		"name": "bash",
		"path": "config/bash",
		"description": "Omarchy Bash user configuration",
		"dependencies": ["tmux"],
		"arch_packages": ["thefuck"],
		"prerequisites": [],
		"validators": [
			"bash -n \"$HOME/.bashrc\"",
			"bash --noprofile --norc -c 'unset OMARCHY_PATH; source \"$HOME/.bashrc\"; [[ ${OMARCHY_PATH:-} == /usr/share/omarchy ]]'"
		],
		"documentation": "docs/bash.md",
		"cleanup": [
			"Removing this package leaves ~/.bashrc absent; migration backups remain under the Dotfiles XDG state backup tree",
			"Arch package thefuck remains installed"
		]
	}, {
		"name": "tmux",
		"path": "config/tmux",
		"description": "Private tmux session starter",
		"dependencies": [],
		"arch_packages": ["tmux", "fzf"],
		"prerequisites": [],
		"validators": [
			"sh -n \"$HOME/.local/libexec/dotfiles/tmux-starter\"",
			"sh -c 'test -x \"$HOME/.local/libexec/dotfiles/tmux-starter\"'"
		],
		"documentation": "docs/tmux.md",
		"cleanup": [
			"Arch packages tmux and fzf remain installed",
			"The tmux server, sessions, logs, and state are not removed"
		]
	}, {
		"name": "ghostty",
		"path": "config/ghostty",
		"description": "Omarchy-integrated Ghostty configuration",
		"dependencies": [],
		"arch_packages": [],
		"prerequisites": ["ghostty"],
		"validators": ["ghostty +validate-config --config-file=\"$HOME/.config/ghostty/config\""],
		"documentation": "docs/ghostty.md",
		"cleanup": []
	}]
}
