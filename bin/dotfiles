#!/usr/bin/env bash

set -euo pipefail

readonly DOTFILES_ENTRY_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

# shellcheck source=../lib/dotfiles/core.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/core.sh"
# shellcheck source=../lib/dotfiles/packages.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/packages.sh"
# shellcheck source=../lib/dotfiles/skills.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/skills.sh"
# shellcheck source=../lib/dotfiles/cleanup.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/cleanup.sh"
# shellcheck source=../lib/dotfiles/wizard.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/wizard.sh"

case ${1-wizard} in
	wizard)
		wizard
		;;
	status)
		status
		;;
	check)
		check
		;;
	apply)
		shift
		apply_package "$@"
		;;
	remove)
		shift
		remove_package "$@"
		;;
	migrate)
		shift
		migrate_target "$@"
		;;
	prerequisites)
		shift
		setup_prerequisites "$@"
		;;
	skills)
		shift
		install_skills "$@"
		;;
	skills-update)
		shift
		update_skills "$@"
		;;
	*)
		printf 'Unknown command: %s\n' "$1" >&2
		exit 2
		;;
esac
