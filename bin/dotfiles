#!/usr/bin/env bash

set -euo pipefail

readonly DOTFILES_ENTRY_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

# shellcheck source=../lib/dotfiles/core.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/core.sh"
# shellcheck source=../lib/dotfiles/applications.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/applications.sh"
# shellcheck source=../lib/dotfiles/screensaver-effects.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/screensaver-effects.sh"
# shellcheck source=../lib/dotfiles/packages.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/packages.sh"
# shellcheck source=../lib/dotfiles/skills.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/skills.sh"
# shellcheck source=../lib/dotfiles/cleanup.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/cleanup.sh"
# shellcheck source=../lib/dotfiles/modem.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/modem.sh"
# shellcheck source=../lib/dotfiles/brave.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/brave.sh"
# shellcheck source=../lib/dotfiles/power-policy.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/power-policy.sh"
# shellcheck source=../lib/dotfiles/telegram-theme.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/telegram-theme.sh"
# shellcheck source=../lib/dotfiles/wallpapers.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/wallpapers.sh"
# shellcheck source=../lib/dotfiles/shell-layout.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/shell-layout.sh"
# shellcheck source=../lib/dotfiles/discord-system24.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/discord-system24.sh"
# shellcheck source=../lib/dotfiles/obs.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/obs.sh"
# shellcheck source=../lib/dotfiles/obs-set.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/obs-set.sh"
# shellcheck source=../lib/dotfiles/voxtype.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/voxtype.sh"
# shellcheck source=../lib/dotfiles/hypr-profile.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/hypr-profile.sh"
# shellcheck source=../lib/dotfiles/wizard.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/wizard.sh"

if (($# == 0)); then
	wizard
elif (($# == 2)) && [[ $1 == --action ]]; then
	wizard_run_action "$2"
elif (($# == 3 || $# == 4)) && [[ $1 == --action && $2 == obs-set && ${4---force} == --force ]]; then
	wizard_run_action obs-set "${@:3}"
else
	printf '%s\n' \
		'Usage: bin/dotfiles [--action <guided|status|check|apply|migrate|remove|prerequisites|cleanup|applications|skills|skills-update|modem|brave|telegram-theme|wallpapers|wallpapers-apply|wallpapers-remove|shell-layout|screensaver-effects|screensaver-effects-migrate|power-policy|discord-patch|obs-set|obs-diagnose|voxtype-profile|hypr-profile>]' \
		'  wallpapers: curate the repository Wallpaper library' \
		'  wallpapers-apply: deploy the Wallpaper library' \
		'  wallpapers-remove: remove receipt-owned deployed wallpapers' \
		'  shell-layout: place the language indicator before the tray through Omarchy' \
		'  screensaver-effects: manage and preview the deployed effect allowlist' \
		'  screensaver-effects-migrate: migrate competing Omarchy idle or Indicators clones' \
		'  discord-patch: patch the newest Discord app directory with Vencord' \
		'  obs-set [set [--force]]: copy an OBS machine set from obs/sets/ into OBS; --force replaces existing items after a backup' \
		'  obs-diagnose: report the display and encoder facts an OBS machine set needs' \
		'  voxtype-profile: point ~/.config/voxtype/config.toml at a tracked pc or laptop profile' \
		'  hypr-profile: point ~/.config/hypr/machine at a tracked pc or laptop machine profile' >&2
	exit 2
fi
