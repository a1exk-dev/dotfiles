#!/usr/bin/env bash

set -euo pipefail

readonly DOTFILES_ENTRY_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

# shellcheck source=../lib/dotfiles/core.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/core.sh"
# shellcheck source=../lib/dotfiles/packages.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/packages.sh"
# shellcheck source=../lib/dotfiles/skills.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/skills.sh"
# shellcheck source=../lib/dotfiles/cleanup.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/cleanup.sh"
# shellcheck source=../lib/dotfiles/modem.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/modem.sh"
# shellcheck source=../lib/dotfiles/brave.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/brave.sh"
# shellcheck source=../lib/dotfiles/telegram-theme.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/telegram-theme.sh"
# shellcheck source=../lib/dotfiles/wallpapers.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/wallpapers.sh"
# shellcheck source=../lib/dotfiles/wizard.sh
source "$DOTFILES_ENTRY_ROOT/lib/dotfiles/wizard.sh"

if (($# == 0)); then
	wizard
elif (($# == 2)) && [[ $1 == --action ]]; then
	wizard_run_action "$2"
else
	printf '%s\n' \
		'Usage: bin/dotfiles [--action <guided|status|check|apply|migrate|remove|prerequisites|cleanup|skills|skills-update|modem|brave|telegram-theme|wallpapers|wallpapers-apply|wallpapers-remove>]' \
		'  wallpapers: curate the repository Wallpaper library' \
		'  wallpapers-apply: deploy the Wallpaper library' \
		'  wallpapers-remove: remove receipt-owned deployed wallpapers' >&2
	exit 2
fi
