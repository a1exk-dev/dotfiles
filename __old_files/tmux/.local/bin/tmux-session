#!/bin/sh

set -eu

# TMUX can leak into terminal environments, so verify the current TTY is a pane.
inside_tmux=
if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
  current_tty=$(tty 2>/dev/null) || current_tty=
  pane_tty=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_tty}' 2>/dev/null) || pane_tty=
  if [ -n "$current_tty" ] && [ "$current_tty" = "$pane_tty" ]; then
    inside_tmux=1
  fi
fi

if [ -z "$inside_tmux" ]; then
  unset TMUX TMUX_PANE
fi

sessions=$(tmux list-sessions -F '#{session_name}' 2>/dev/null) || sessions=

if [ -z "$inside_tmux" ] && [ -z "$sessions" ]; then
  exec tmux new-session -s main -c "$PWD"
fi

if ! command -v fzf >/dev/null 2>&1; then
  printf 'tmux-session: fzf is required\n' >&2
  exit 1
fi

fzf_status=0
choice=$(
  {
    printf 'new Create a new session\n'
    if [ -n "$sessions" ]; then
      printf '%s\n' "$sessions" | while IFS= read -r session; do
        printf 'attach %s\n' "$session"
      done
    fi
  } | fzf \
    --delimiter=' ' \
    --with-nth=2.. \
    --height=40% \
    --layout=reverse \
    --border \
    --print-query \
    --prompt='tmux session> '
) || fzf_status=$?

case $fzf_status in
  0)
    newline='
'
    query=${choice%%"$newline"*}
    choice=${choice#*"$newline"}
    action=${choice%% *}
    session_name=${choice#* }
    ;;
  1)
    action=new
    query=$choice
    session_name=$query
    ;;
  130)
    exit 0
    ;;
  *)
    exit "$fzf_status"
    ;;
esac

if [ "$action" = new ]; then
  if [ -n "$query" ]; then
    session_name=$query
  else
    printf 'Session name: '
    IFS= read -r session_name
  fi
  [ -n "$session_name" ] || exit 0
elif [ "$action" != attach ]; then
  printf 'tmux-session: invalid selection\n' >&2
  exit 1
fi

if tmux has-session -t "=$session_name" 2>/dev/null; then
  if [ -n "$inside_tmux" ]; then
    exec tmux switch-client -t "=$session_name"
  fi
  exec tmux attach-session -t "=$session_name"
fi

if [ -n "$inside_tmux" ]; then
  tmux new-session -d -s "$session_name" -c "$PWD"
  exec tmux switch-client -t "=$session_name"
fi

exec tmux new-session -s "$session_name" -c "$PWD"
