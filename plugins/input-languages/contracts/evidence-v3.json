{
	"version": 3,
	"integration": "dotfiles-input-languages-fcitx-v1",
	"identity": "dotfiles-input-languages-evidence-v3",
	"field_schema": {
		"references": "Field names mapped to a key in types or objects.",
		"constants": "Field names mapped to one exact value.",
		"enums": "Field names mapped to their complete allowed value array."
	},
	"version_2": {
		"immutable": true,
		"supported_operations": ["direct-status", "remove", "rollback", "expansion-input"],
		"exact_keys": {
			"active": ["version", "operation", "transaction_id", "backup_transaction_id", "source_id", "build_id", "artifact", "artifact_sha256", "widget_sha256", "compatibility_hash", "compiler", "compiler_warning", "dependencies", "backup", "backup_digest", "backup_existed", "widget_source", "widget_section", "widget_index", "widget_entry", "prior_stock_present", "prior_stock_section", "prior_stock_index", "prior_stock_entry"],
			"pending": ["version", "operation", "transaction_id", "phase", "backup_transaction_id", "backup", "backup_digest", "backup_existed", "artifact", "prior_tree", "prior_active", "prior_active_digest", "prior_pointer", "prior_pointer_digest", "prior_group", "prior_autoreload", "prior_widget_present", "prior_widget_section", "prior_widget_index", "prior_widget_entry", "prior_widget_link", "widget_action", "widget_mutated", "widget_section", "widget_index", "widget_entry", "link_mutated"],
			"recovery_required": ["version", "state", "transaction_id", "failed_phase", "pending"],
			"remove_cleanup": ["version", "state", "transaction_id", "archive", "archive_active_digest", "archive_pending_digest", "artifact", "build_id", "artifact_sha256"]
		}
	},
	"types": {
		"array-addon_state": {"type": "array", "items_ref": "addon_state"},
		"array-device-group": {"type": "array", "items_ref": "device_group"},
		"array-string": {"type": "array", "items": {"type": "string"}},
		"boolean": {"type": "boolean"},
		"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
		"empty-or-owned-method": {"type": "string", "enum": ["", "keyboard-us", "keyboard-ru"]},
		"integer": {"type": "integer", "minimum": 0},
		"integer-or-null": {"type": ["integer", "null"], "minimum": 0},
		"language": {"type": "string", "enum": ["US", "Russian"]},
		"managed-group-or-null": {"one_of": [{"object_ref": "managed_group"}, {"type": "null"}]},
		"mode": {"type": "string", "pattern": "^[0-7]{4}$"},
		"mode-0600": {"type": "string", "const": "0600"},
		"numeric-string": {"type": "string", "pattern": "^[0-9]+$"},
		"nullable_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
		"nullable_path": {"type": ["string", "null"], "absolute_when_string": true},
		"nullable_string": {"type": ["string", "null"]},
		"object": {"type": "object"},
		"object-or-null": {"type": ["object", "null"]},
		"ordered-array-expected_state": {"type": "array", "items_ref": "expected_state", "order": "phase_order"},
		"ordered-array-fcitx_group": {"type": "array", "items_ref": "fcitx_group", "order": "Controller1 InputMethodGroups"},
		"ordered-array-fcitx_item": {"type": "array", "items_ref": "fcitx_item", "order": "Controller1 group order"},
		"ordered-keyboard-us-keyboard-ru": {"type": "array", "const": [{"method": "keyboard-us", "layout_override": ""}, {"method": "keyboard-ru", "layout_override": ""}]},
		"path": {"type": "string", "absolute": true},
		"phase": {"type": "string", "enum_ref": "phase_order"},
		"regular": {"type": "string", "const": "regular"},
		"runtime-identity-or-null": {"one_of": [{"object_ref": "runtime_identity"}, {"type": "null"}]},
		"string": {"type": "string", "minimum_length": 1}
	},
	"objects": {
		"direct_ancestry": {
			"keys": ["receipt", "receipt_digest", "backup_transaction_id", "backup", "backup_digest", "backup_existed"],
			"references": {"receipt": "path", "receipt_digest": "digest", "backup_transaction_id": "string", "backup": "path", "backup_digest": "digest", "backup_existed": "boolean"}
		},
		"device_group": {
			"keys": ["device", "group"],
			"references": {"device": "string", "group": "integer"}
		},
		"integration_artifact": {
			"keys": ["source_id", "build_id", "artifact", "artifact_sha256", "helper_sha256", "widget_sha256", "protocol_identity", "controller_identity", "health_identity", "unit_identity", "compatibility_hash", "compiler", "compiler_warning", "dependencies", "inventory"],
			"references": {"source_id": "digest", "build_id": "digest", "artifact": "path", "artifact_sha256": "digest", "helper_sha256": "digest", "widget_sha256": "digest", "protocol_identity": "string", "controller_identity": "string", "health_identity": "string", "unit_identity": "string", "compatibility_hash": "string", "compiler": "string", "compiler_warning": "nullable_string", "dependencies": "string", "inventory": "array-string"}
		},
		"profile_evidence": {
			"keys": ["path", "type", "uid", "mode", "digest"],
			"references": {"path": "path", "type": "regular", "uid": "integer", "mode": "mode-0600", "digest": "digest"}
		},
		"service_snapshot": {
			"keys": ["unit", "fragment_path", "fragment_digest", "active_state", "sub_state", "main_pid", "unique_owner"],
			"references": {"unit": "string", "fragment_path": "path", "fragment_digest": "digest", "active_state": "string", "sub_state": "string", "main_pid": "integer", "unique_owner": "string"}
		},
		"fcitx_item": {
			"keys": ["method", "layout_override", "display_name", "native_name", "language_code", "addon", "configurable", "variant", "properties"],
			"references": {"method": "string", "layout_override": "nullable_string", "display_name": "string", "native_name": "string", "language_code": "string", "addon": "string", "configurable": "boolean", "variant": "nullable_string", "properties": "object"}
		},
		"fcitx_group": {
			"keys": ["name", "default_layout", "default_im", "properties", "items"],
			"references": {"name": "string", "default_layout": "string", "default_im": "nullable_string", "properties": "object", "items": "ordered-array-fcitx_item"}
		},
		"addon_state": {
			"keys": ["name", "enabled", "available"],
			"references": {"name": "string", "enabled": "boolean", "available": "boolean"}
		},
		"fcitx_semantic_snapshot": {
			"keys": ["profile_evidence", "owner", "owner_epoch", "service", "groups", "current_group", "observed_method", "observed_method_nonempty", "available_methods", "addons"],
			"references": {"profile_evidence": "profile_evidence", "owner": "string", "owner_epoch": "integer", "service": "service_snapshot", "groups": "ordered-array-fcitx_group", "current_group": "string", "observed_method": "nullable_string", "observed_method_nonempty": "boolean", "available_methods": "array-string", "addons": "array-addon_state"}
		},
		"managed_group": {
			"keys": ["name", "default_layout", "default_im", "items"],
			"references": {"default_im": "empty-or-owned-method", "items": "ordered-keyboard-us-keyboard-ru"},
			"constants": {"name": "Dotfiles Input Languages", "default_layout": "us"}
		},
		"helper_edge": {
			"keys": ["path", "type", "target", "digest", "enabled", "active"],
			"references": {"path": "path", "type": "string", "target": "nullable_path", "digest": "nullable_digest", "enabled": "boolean", "active": "boolean"}
		},
		"runtime_identity": {
			"keys": ["uid", "mode", "device", "inode"],
			"references": {"uid": "integer", "mode": "mode", "device": "numeric-string", "inode": "numeric-string"}
		},
		"runtime_edge": {
			"keys": ["path", "type", "target", "digest", "enabled", "active", "identity"],
			"references": {"path": "path", "type": "string", "target": "nullable_path", "digest": "nullable_digest", "enabled": "boolean", "active": "boolean", "identity": "runtime-identity-or-null"}
		},
		"helper_ownership": {
			"keys": ["socket_unit", "service_unit", "socket_enablement", "artifact_pointer", "runtime_directory", "socket_path"],
			"references": {"socket_unit": "helper_edge", "service_unit": "helper_edge", "socket_enablement": "helper_edge", "artifact_pointer": "helper_edge", "runtime_directory": "runtime_edge", "socket_path": "runtime_edge"}
		},
		"hyprland_ownership": {
			"keys": ["tree_state", "source_id", "active_artifact_pointer", "autoreload", "canonical_language", "physical_groups"],
			"references": {"tree_state": "string", "source_id": "digest", "active_artifact_pointer": "path", "autoreload": "boolean", "canonical_language": "language", "physical_groups": "array-device-group"}
		},
		"widget_ownership": {
			"keys": ["source", "source_digest", "live_link", "section", "index", "entry", "prior_stock_present", "prior_stock_section", "prior_stock_index", "prior_stock_entry"],
			"references": {"source": "path", "source_digest": "digest", "live_link": "path", "section": "string", "index": "integer", "entry": "object", "prior_stock_present": "boolean", "prior_stock_section": "nullable_string", "prior_stock_index": "integer-or-null", "prior_stock_entry": "object-or-null"}
		},
		"operation_start": {
			"keys": ["canonical_language", "physical_groups", "fcitx_method"],
			"references": {"canonical_language": "language", "physical_groups": "array-device-group", "fcitx_method": "nullable_string"}
		},
		"restoration": {
			"keys": ["direct", "fcitx", "helper", "language"],
			"references": {"direct": "string", "fcitx": "string", "helper": "string", "language": "string"}
		},
		"expected_state": {
			"keys": ["phase", "direct_digest", "fcitx_semantic_digest", "helper_digest", "receipt_digest"],
			"references": {"phase": "phase", "direct_digest": "nullable_digest", "fcitx_semantic_digest": "nullable_digest", "helper_digest": "nullable_digest", "receipt_digest": "nullable_digest"}
		},
		"active": {
			"keys": ["version", "operation", "transaction_id", "direct_ancestry", "integration_artifact", "fcitx_before", "managed_group", "helper_ownership", "hyprland_ownership", "widget_ownership", "operation_start", "restoration"],
			"references": {"transaction_id": "string", "direct_ancestry": "direct_ancestry", "integration_artifact": "integration_artifact", "fcitx_before": "fcitx_semantic_snapshot", "managed_group": "managed_group", "helper_ownership": "helper_ownership", "hyprland_ownership": "hyprland_ownership", "widget_ownership": "widget_ownership", "operation_start": "operation_start", "restoration": "restoration"},
			"constants": {"version": 3, "operation": "active"}
		},
		"pending": {
			"keys": ["version", "operation", "transaction_id", "phase", "prior_active", "prior_active_digest", "direct_ancestry", "integration_artifact", "fcitx_before", "managed_group_before", "managed_group_target", "helper_before", "helper_target", "hyprland_before", "widget_before", "operation_start", "expected_states", "restoration"],
			"references": {"transaction_id": "string", "phase": "phase", "prior_active": "nullable_path", "prior_active_digest": "nullable_digest", "direct_ancestry": "direct_ancestry", "integration_artifact": "integration_artifact", "fcitx_before": "fcitx_semantic_snapshot", "managed_group_before": "managed-group-or-null", "managed_group_target": "managed-group-or-null", "helper_before": "helper_ownership", "helper_target": "helper_ownership", "hyprland_before": "hyprland_ownership", "widget_before": "widget_ownership", "operation_start": "operation_start", "expected_states": "ordered-array-expected_state", "restoration": "restoration"},
			"constants": {"version": 3},
			"enums": {"operation": ["apply", "remove"]}
		},
		"recovery_required": {
			"keys": ["version", "state", "transaction_id", "failed_phase", "pending", "pending_digest", "restoration"],
			"references": {"transaction_id": "string", "failed_phase": "phase", "pending": "path", "pending_digest": "digest", "restoration": "restoration"},
			"constants": {"version": 3, "state": "recovery-required"}
		},
		"integration_cleanup": {
			"keys": ["artifact", "build_id", "artifact_sha256", "helper_edges", "runtime_edges"],
			"references": {"artifact": "path", "build_id": "digest", "artifact_sha256": "digest", "helper_edges": "helper_ownership", "runtime_edges": "helper_ownership"}
		},
		"remove_cleanup": {
			"keys": ["version", "state", "transaction_id", "archive", "archive_active_digest", "archive_pending_digest", "integration_cleanup"],
			"references": {"transaction_id": "string", "archive": "path", "archive_active_digest": "digest", "archive_pending_digest": "digest", "integration_cleanup": "integration_cleanup"},
			"constants": {"version": 3, "state": "remove-cleanup"}
		}
	},
	"phase_order": {
		"apply": ["prepared", "prior-helper-quiesced", "managed-group-created", "managed-group-populated", "managed-group-selected", "managed-group-saved", "units-published", "manager-reloaded", "socket-started", "pointer-published", "hyprland-transitioned", "hyprland-reloaded", "helper-ready", "reset-issued", "verified", "active-published"],
		"remove": ["prepared", "authority-quiesced", "prior-group-selected", "prior-method-restored", "managed-group-removed", "managed-group-saved", "hyprland-restored", "helper-edges-removed", "manager-reloaded", "verified", "active-archived"],
		"rollback": ["authority-quiesced", "direct-restored", "fcitx-semantic-delta-reversed", "helper-state-restored", "operation-start-language-restored", "verified"]
	},
	"raw_profile_restoration_allowed": false,
	"active_receipt_publish_order": "last"
}
