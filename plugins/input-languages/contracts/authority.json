{
	"version": 1,
	"integration": "dotfiles-input-languages-fcitx-v1",
	"identity": "dotfiles-input-languages-authority-v1",
	"languages": [
		{
			"name": "US",
			"xkb_group": 0,
			"fcitx_method": "keyboard-us"
		},
		{
			"name": "Russian",
			"xkb_group": 1,
			"fcitx_method": "keyboard-ru"
		}
	],
	"authority_session": {
		"owner": "hyprland-plugin",
		"format": "lowercase-hex",
		"bytes": 16,
		"fresh_per_plugin_authority": true
	},
	"generation": {
		"type": "uint64",
		"scope": "authority-session",
		"initial": 1,
		"increments_on": [
			"valid-chord-change",
			"explicit-physical-change",
			"explicit-flag-change",
			"effective-keymap-change"
		],
		"unchanged_on": [
			"same-target-request",
			"hotplug-convergence",
			"focus-change",
			"helper-observation",
			"fcitx-observation",
			"unchanged-keymap-reload"
		]
	},
	"commit_order": [
		"commit-explicit-target",
		"fan-out-physical-keyboards",
		"notify-seat",
		"offer-fcitx-once"
	],
	"follower_rules": {
		"fcitx_is_authority": false,
		"transport_toggle_allowed": false,
		"drift_direction": "toward-canonical-target",
		"direct_xkb_waits_for_fcitx": false
	}
}
