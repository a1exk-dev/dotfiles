{
	"version": 1,
	"integration": "dotfiles-input-languages-fcitx-v1",
	"identity": "dotfiles-input-languages-health-v1",
	"protocol": "dotfiles-input-languages-fcitx-seqpacket-v1",
	"snapshot_keys": [
		"healthy",
		"direct_xkb_health",
		"build_id",
		"source_id",
		"compatibility_hash",
		"canonical_group",
		"physical_keyboards",
		"excluded_keyboards",
		"authority_session",
		"canonical_language",
		"canonical_generation",
		"physical_groups",
		"physical_synchronized",
		"helper_connection",
		"helper_build_id",
		"protocol_identity",
		"offered_generation",
		"accepted_generation",
		"acknowledged_generation",
		"report_sequence",
		"report_age_milliseconds",
		"coalesced_targets",
		"fcitx_owner_state",
		"fcitx_unique_owner",
		"fcitx_owner_epoch",
		"managed_group_state",
		"current_group",
		"observed_method",
		"retry_phase",
		"outcome",
		"diagnostic",
		"report_stale"
	],
	"snapshot_fields": {
		"healthy": {"type": "boolean", "meaning": "direct-xkb-synchronized"},
		"direct_xkb_health": {"type": "string", "enum": ["healthy", "unhealthy"]},
		"build_id": {"type": "string", "format": "sha256"},
		"source_id": {"type": "string", "format": "sha256"},
		"compatibility_hash": {"type": "string", "minimum_length": 1},
		"canonical_group": {"type": "integer", "enum": [0, 1]},
		"physical_keyboards": {"type": "array", "items": {"type": "string", "minimum_length": 1}, "unique": true},
		"excluded_keyboards": {"type": "array", "items": {"type": "string", "minimum_length": 1}, "unique": true},
		"authority_session": {"type": "string", "format": "lowercase-hex-32"},
		"canonical_language": {"type": "string", "enum": ["US", "Russian"]},
		"canonical_generation": {"type": "integer", "format": "uint64", "minimum": 1},
		"physical_groups": {"type": "array", "items_ref": "evidence-v3.objects.device_group", "unique_by": "device"},
		"physical_synchronized": {"type": "boolean"},
		"helper_connection": {"type": "string", "enum": ["connected", "disconnected", "failed", "incompatible"]},
		"helper_build_id": {"type": ["string", "null"], "format": "sha256"},
		"protocol_identity": {"type": "string", "minimum_length": 1},
		"offered_generation": {"type": "integer", "format": "uint64", "minimum": 1},
		"accepted_generation": {"type": ["integer", "null"], "format": "uint64", "minimum": 1},
		"acknowledged_generation": {"type": ["integer", "null"], "format": "uint64", "minimum": 1},
		"report_sequence": {"type": ["integer", "null"], "format": "uint64", "minimum": 1},
		"report_age_milliseconds": {"type": ["integer", "null"], "format": "uint64"},
		"coalesced_targets": {"type": "integer", "format": "uint64"},
		"fcitx_owner_state": {"type": "string", "enum": ["present", "absent", "competing"]},
		"fcitx_unique_owner": {"type": ["string", "null"], "minimum_length": 1},
		"fcitx_owner_epoch": {"type": "integer", "format": "uint64"},
		"managed_group_state": {"type": "string", "enum": ["unknown", "exact", "missing", "foreign"]},
		"current_group": {"type": ["string", "null"], "minimum_length": 1},
		"observed_method": {"type": "string"},
		"retry_phase": {"type": "string", "enum": ["none", "poll", "read", "write", "read-before-retry", "backoff"]},
		"outcome": {"type": "string", "enum_ref": "helper_outcomes"},
		"diagnostic": {"type": "string", "maximum_utf8_bytes": 96},
		"report_stale": {"type": "boolean"}
	},
	"cross_field_relationships": {
		"canonical_language_matches_group": true,
		"physical_keyboard_names_equal_group_devices": true,
		"healthy_equals_direct_xkb_health_and_physical_synchronized": true,
		"physical_synchronized_requires_nonempty_groups_at_canonical_group": true,
		"offered_generation_equals_canonical_generation": true,
		"connected_requires_matching_helper_build": true,
		"disconnected_failed_or_incompatible_requires_null_helper_build": true,
		"report_sequence_age_and_stale_are_jointly_present": true,
		"owner_present_or_competing_requires_alias_and_positive_epoch": true,
		"owner_absent_requires_null_alias": true,
		"acknowledgement_requires_current_generation_present_owner_exact_managed_current_group_converged_nonempty_matching_method_fresh_report": true
	},
	"helper_outcomes": [
		"pending",
		"converged",
		"idle-no-context",
		"drift",
		"unavailable",
		"disconnected",
		"timeout-indeterminate",
		"method-error",
		"configuration-conflict",
		"unsupported-interface",
		"protocol-error",
		"helper-failed"
	],
	"runtime_states": ["converged", "pending", "unavailable", "stale", "conflicting"],
	"outcome_runtime_state": {
		"pending": "pending",
		"converged": "converged",
		"idle-no-context": "pending",
		"drift": "pending",
		"unavailable": "unavailable",
		"disconnected": "unavailable",
		"timeout-indeterminate": "pending",
		"method-error": "pending",
		"configuration-conflict": "conflicting",
		"unsupported-interface": "conflicting",
		"protocol-error": "conflicting",
		"helper-failed": "unavailable"
	},
	"heartbeat_maximum_interval_seconds": 1,
	"maximum_fresh_report_age_seconds": 3,
	"report_older_than_maximum_is_stale": true,
	"acknowledgement_requires": [
		"same-authority-session",
		"same-protocol",
		"same-artifact",
		"newest-report-sequence",
		"same-generation",
		"same-owner-epoch",
		"nonempty-matching-method"
	],
	"classification": {
		"precedence": ["recovery-required", "conflict", "uninstalled", "healthy", "degraded"],
		"idle-no-context_runtime": "pending",
		"idle-no-context_overall": "degraded",
		"healthy_requires": "converged",
		"exact-ownership_pending-unavailable-stale": "degraded",
		"structural-or-interface-incompatibility": "conflict"
	}
}
