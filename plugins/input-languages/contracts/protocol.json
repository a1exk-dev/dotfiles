{
	"version": 1,
	"integration": "dotfiles-input-languages-fcitx-v1",
	"identity": "dotfiles-input-languages-fcitx-seqpacket-v1",
	"transport": {
		"family": "AF_UNIX",
		"type": "SOCK_SEQPACKET",
		"path": "$XDG_RUNTIME_DIR/dotfiles-input-languages/fcitx.sock",
		"parent_mode": "0700",
		"socket_mode": "0600",
		"peer_authentication": "same-uid-so-peercred",
		"descriptor_flags": [
			"nonblocking",
			"close-on-exec"
		],
		"maximum_packet_bytes": 1024,
		"authenticated_authorities": 1
	},
	"wire": {
		"byte_order": "little-endian",
		"header_bytes": 12,
		"header": [
			{"name": "magic", "type": "u32", "value": "0x44494c46"},
			{"name": "protocol_version", "type": "u16", "value": 1},
			{"name": "frame_type", "type": "u16"},
			{"name": "payload_bytes", "type": "u16", "maximum": 1012},
			{"name": "reserved", "type": "u16", "value": 0}
		],
		"scalars": {
			"authority_session": "16-byte-nonce",
			"diagnostic": "u16-length-prefixed-utf8-maximum-96-bytes",
			"digest": "64-byte-lowercase-hex",
			"generation": "u64",
			"identity": "u16-length-prefixed-utf8-maximum-96-bytes",
			"language": "u8-enum-us-0-russian-1",
			"managed_group_state": "u8-enum",
			"nullable_text": "u8-presence-followed-by-u16-length-prefixed-nonempty-utf8-maximum-96-bytes",
			"optional_generation": "u8-presence-followed-by-u64",
			"owner_state": "u8-enum",
			"owner_epoch": "u64",
			"outcome": "u8-enum",
			"report_sequence": "u64",
			"retry_phase": "u8-enum",
			"text": "u16-length-prefixed-utf8-maximum-96-bytes"
		},
		"enums": {
			"managed_group_state": {"unknown": 0, "exact": 1, "missing": 2, "foreign": 3},
			"owner_state": {"absent": 0, "present": 1, "competing": 2},
			"outcome": {"pending": 0, "converged": 1, "idle-no-context": 2, "drift": 3, "unavailable": 4, "disconnected": 5, "timeout-indeterminate": 6, "method-error": 7, "configuration-conflict": 8, "unsupported-interface": 9, "protocol-error": 10, "helper-failed": 11},
			"retry_phase": {"none": 0, "poll": 1, "read": 2, "write": 3, "read-before-retry": 4, "backoff": 5}
		}
	},
	"frames": {
		"HELLO": {
			"type": 1,
			"fields": [
				{"name": "protocol_identity", "scalar": "identity"},
				{"name": "build_id", "scalar": "digest"},
				{"name": "source_id", "scalar": "digest"},
				{"name": "authority_session", "scalar": "authority_session"},
				{"name": "language", "scalar": "language"},
				{"name": "generation", "scalar": "generation"}
			]
		},
		"READY": {
			"type": 2,
			"fields": [
				{"name": "protocol_identity", "scalar": "identity"},
				{"name": "build_id", "scalar": "digest"},
				{"name": "source_id", "scalar": "digest"},
				{"name": "authority_session", "scalar": "authority_session"}
			]
		},
		"TARGET": {
			"type": 3,
			"fields": [
				{"name": "authority_session", "scalar": "authority_session"},
				{"name": "language", "scalar": "language"},
				{"name": "generation", "scalar": "generation"}
			]
		},
		"STATE": {
			"type": 4,
			"fields": [
				{"name": "protocol_identity", "scalar": "identity"},
				{"name": "build_id", "scalar": "digest"},
				{"name": "authority_session", "scalar": "authority_session"},
				{"name": "report_sequence", "scalar": "report_sequence"},
				{"name": "accepted_generation", "scalar": "generation"},
				{"name": "acknowledged_generation", "scalar": "optional_generation"},
				{"name": "owner_state", "scalar": "owner_state"},
				{"name": "unique_owner", "scalar": "nullable_text"},
				{"name": "owner_epoch", "scalar": "owner_epoch"},
				{"name": "managed_group_state", "scalar": "managed_group_state"},
				{"name": "current_group", "scalar": "nullable_text"},
				{"name": "observed_method", "scalar": "text"},
				{"name": "outcome", "scalar": "outcome"},
				{"name": "retry_phase", "scalar": "retry_phase"},
				{"name": "diagnostic", "scalar": "diagnostic"}
			]
		},
		"HEARTBEAT": {
			"type": 5,
			"fields": [
				{"name": "authority_session", "scalar": "authority_session"},
				{"name": "report_sequence", "scalar": "report_sequence"}
			]
		}
	},
	"connection_retry_milliseconds": [100, 200, 400, 800, 1600, 2000],
	"connection_retry_cap_milliseconds": 2000,
	"connection_retry_reset": "READY",
	"reject": [
		"truncated-packet",
		"oversized-packet",
		"unknown-frame-type",
		"type-length-mismatch",
		"nonzero-reserved-field",
		"protocol-mismatch",
		"artifact-mismatch",
		"unauthenticated-peer",
		"second-authority"
	]
}
