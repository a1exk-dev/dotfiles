{
	"layer": "top",
	"position": "top",
	"exclusive": true,
	"margin-top": 4,
	"margin-left": 4,
	"margin-right": 4,
	"modules-left": [
		"backlight",
		"custom/bracket-left",
		"custom/backlight-bar",
		"custom/bracket-right",
		"hyprland/workspaces"
	],
    "modules-center": [
		"clock"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "power-profiles-daemon",
        "battery",
        "tray"
    ],

	"backlight": {
		"device": "intel_backlight",
		"on-scroll-up": "~/.config/waybar/widgets/brightness.sh up",
		"on-scroll-down": "~/.config/waybar/widgets/brightness.sh down",
		"format": "{icon}",
		"format-icons": ["", "", "", "", "", "", "", "", ""],
		"tooltip": false
	},

	"custom/bracket-left": {
		"exec": "~/.config/waybar/widgets/bracket.sh left",
		"return-type": "json",
		"format": "{text}",
		"interval": "once",
		"tooltip": false
	},

	"custom/backlight-bar": {
		"exec": "~/.config/waybar/widgets/brightness.sh get",
		"on-scroll-up": "~/.config/waybar/widgets/brightness.sh up",
		"on-scroll-down": "~/.config/waybar/widgets/brightness.sh down",
		"return-type": "json",
		"format": "{text}",
		"interval": 1,
		"escape": false,
		"tooltip": false
	},

	"custom/bracket-right": {
		"exec": "~/.config/waybar/widgets/bracket.sh right",
		"return-type": "json",
		"format": "{text}",
		"interval": "once",
		"tooltip": false
	}
}
