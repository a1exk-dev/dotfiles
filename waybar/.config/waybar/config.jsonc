{
	"layer": "top",
	"position": "top",
	"exclusive": true,
	"margin-top": 4,
	"margin-left": 4,
	"margin-right": 4,
	"height": 28,
	"modules-left": [
		"group/volume",
		"wireplumber#mic",
		"group/wireless",
		"power-profiles-daemon",
		"custom/wlogout",
		"hyprland/language"
	],
	"modules-center": [
		"clock#hours",
		"custom/workspaces",
		"clock#minutes"
	],
	"modules-right": [
		"custom/privacy",
		"tray",
		"group/brightness",
		"group/battery",
		"custom/notifications",
	],

	"custom/brightness-icon": {
		"exec": "~/.config/waybar/widgets/brightness-icon.sh",
		"on-scroll-up": "~/.config/waybar/widgets/brightness.sh up",
		"on-scroll-down": "~/.config/waybar/widgets/brightness.sh down",
		"return-type": "json",
		"format": "{text}",
		"interval": "once",
		"signal": 1,
		"exec-on-event": false,
		"tooltip": false
	},

	"custom/brightness": {
		"exec": "~/.config/waybar/widgets/brightness.sh get",
		"on-scroll-up": "~/.config/waybar/widgets/brightness.sh up",
		"on-scroll-down": "~/.config/waybar/widgets/brightness.sh down",
		"return-type": "json",
		"format": "[{text}]",
		"interval": "once",
		"signal": 1,
		"exec-on-event": false,
		"escape": false,
		"tooltip": false
	},

	"group/brightness": {
		"orientation": "horizontal",
		"modules": [
			"custom/brightness-icon",
			"custom/brightness"
		]
	},

	"clock#hours": {
		"format": "{:%H}",
		"interval": 1,
		"tooltip": false
	},

	"clock#minutes": {
		"format": "{:%M}",
		"interval": 1,
		"tooltip": false
	},

	"custom/workspaces": {
		"exec": "~/.config/waybar/widgets/workspaces.sh --watch",
		"return-type": "json",
		"format": "{text}",
		"restart-interval": 1,
		"escape": false,
		"tooltip": false
	},

	"hyprland/language": {
		"format": "{}",
		"format-en": "<span foreground=\"#7fbbb3\">[</span>🇺🇸<span foreground=\"#7fbbb3\">]</span>",
		"format-ru": "<span foreground=\"#e67e80\">[</span>🇷🇺<span foreground=\"#e67e80\">]</span>",
		"keyboard-name": "at-translated-set-2-keyboard",
		"on-click": "hyprctl switchxkblayout all next",
		"tooltip": true,
		"tooltip-format": "{long}\nClick to switch layout"
	},

	"wireplumber#mic": {
		"node-type": "Audio/Source",
		"format": "[󰍰]",
		"format-muted": "[󰍱]",
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
		"tooltip": true,
		"tooltip-format": "Toggle Microphone"
	},

	"network#wifi": {
		"format-wifi": "[{icon}]",
		"format-ethernet": "[󰈀]",
		"format-disconnected": "[󰤭]",
		"format-disabled": "[󰖪]",
		"format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
		"tooltip": true,
		"tooltip-format-wifi": "{ifname}: {essid} ({signalStrength}%)",
		"tooltip-format-ethernet": "{ifname}: {ipaddr}",
		"tooltip-format-disconnected": "Network disconnected",
		"tooltip-format-disabled": "Network disabled",
		"on-click": "ghostty --class=wlctl --title=wlctl -e wlctl",
		"interval": 5
	},

	"bluetooth": {
		"format": "[󰂯]",
		"tooltip": true,
		"tooltip-format": "Bluetooth {status}",
		"tooltip-format-disabled": "Bluetooth disabled",
		"tooltip-format-connected": "{device_alias}",
		"tooltip-format-connected-battery": "{device_alias} ({device_battery_percentage}%)",
		"on-click": "ghostty --class=bluetui --title=bluetui -e bluetui",
		"interval": 5
	},

	"group/wireless": {
		"orientation": "horizontal",
		"modules": [
			"network#wifi",
			"bluetooth"
		]
	},

	"custom/volume-icon": {
		"exec": "~/.config/waybar/widgets/volume-icon.sh",
		"on-click": "~/.config/waybar/widgets/volume.sh mute",
		"return-type": "json",
		"format": "{text}",
		"interval": 10,
		"signal": 2,
		"exec-on-event": false,
		"tooltip": true
	},

	"custom/volume": {
		"exec": "~/.config/waybar/widgets/volume.sh get",
		"on-click": "pavucontrol",
		"on-scroll-up": "~/.config/waybar/widgets/volume.sh up",
		"on-scroll-down": "~/.config/waybar/widgets/volume.sh down",
		"return-type": "json",
		"format": "[{text}]",
		"interval": 10,
		"signal": 2,
		"exec-on-event": false,
		"escape": false,
		"tooltip": true,
		"tooltip-format": "Open Mixer"
	},

	"group/volume": {
		"orientation": "horizontal",
		"modules": [
			"custom/volume-icon",
			"custom/volume"
		]
	},

	"custom/battery-icon": {
		"exec": "~/.config/waybar/widgets/battery.sh icon",
		"return-type": "json",
		"format": "{text}",
		"interval": 30,
		"tooltip": true
	},

	"custom/battery-progress": {
		"exec": "~/.config/waybar/widgets/battery.sh progress",
		"return-type": "json",
		"format": "[{text}]",
		"interval": 30,
		"escape": false,
		"tooltip": true
	},

	"group/battery": {
		"orientation": "horizontal",
		"modules": [
			"custom/battery-icon",
			"custom/battery-progress"
		]
	},

	"power-profiles-daemon": {
		"format": "[{icon}]",
		"tooltip-format": "Power profile: {profile}\nDriver: {driver}",
		"tooltip": true,
		"format-icons": {
			"default": "󰐦",
			"performance": "󰓅",
			"balanced": "󰗑",
			"power-saver": "󰌪"
		}
	},

	"custom/privacy": {
		"exec": "~/.config/waybar/widgets/privacy.sh --watch",
		"return-type": "json",
		"format": "[{text}]",
		"restart-interval": 1,
		"escape": false,
		"tooltip": true
	},

	"custom/notifications": {
		"exec": "~/.config/waybar/widgets/notifications.sh",
		"return-type": "json",
		"format": "[{text}]",
		"interval": 1,
		"on-click": "swaync-client --toggle-panel",
		"tooltip": true
	},

	"custom/wlogout": {
		"exec": "printf '{\"text\":\"󰐥\"}'",
		"return-type": "json",
		"format": "[{text}]",
		"interval": "once",
		"on-click": "wlogout",
		"tooltip": true,
		"tooltip-format": "Power"
	},

	"tray": {
		"icon-size": 12,
		"spacing": 10,
		"icons": {
		}
	}
}
