{
	"layer": "top",
	"position": "top",
	"exclusive": true,
	"margin-top": 4,
	"margin-left": 4,
	"margin-right": 4,
	"modules-left": [
		"group/brightness",
		"hyprland/workspaces"
	],
	"modules-center": [
		"clock"
	],
	"modules-right": [
		"pulseaudio",
		"network",
		"power-profiles-daemon",
		"group/battery",
		"tray"
	],

	"custom/brightness-icon": {
		"exec": "~/.config/waybar/widgets/brightness-icon.sh",
		"on-scroll-up": "~/.config/waybar/widgets/brightness.sh up",
		"on-scroll-down": "~/.config/waybar/widgets/brightness.sh down",
		"return-type": "json",
		"format": "{text}",
		"interval": "once",
		"signal": 1,
		"exec-on-event": false,
		"tooltip": false
	},

	"custom/brightness": {
		"exec": "~/.config/waybar/widgets/brightness.sh get",
		"on-scroll-up": "~/.config/waybar/widgets/brightness.sh up",
		"on-scroll-down": "~/.config/waybar/widgets/brightness.sh down",
		"return-type": "json",
		"format": "[{text}]",
		"interval": "once",
		"signal": 1,
		"exec-on-event": false,
		"escape": false,
		"tooltip": false
	},

	"group/brightness": {
		"orientation": "horizontal",
		"modules": [
			"custom/brightness-icon",
			"custom/brightness"
		]
	},

	"custom/battery-icon": {
		"exec": "~/.config/waybar/widgets/battery.sh icon",
		"return-type": "json",
		"format": "{text}",
		"interval": 30,
		"tooltip": false
	},

	"custom/battery-progress": {
		"exec": "~/.config/waybar/widgets/battery.sh progress",
		"return-type": "json",
		"format": "[{text}]",
		"interval": 30,
		"escape": false,
		"tooltip": false
	},

	"custom/battery-info": {
		"exec": "~/.config/waybar/widgets/battery.sh info",
		"return-type": "json",
		"format": "[{text}]",
		"interval": 30,
		"tooltip": false
	},

	"group/battery": {
		"orientation": "horizontal",
		"modules": [
			"custom/battery-icon",
			"custom/battery-progress",
			"custom/battery-info"
		]
	}
}
